<Window x:Class="DeskNest.QuickActionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskNest" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="True" ResizeMode="NoResize" Topmost="True"
        Width="730" Height="212" WindowStartupLocation="Manual"
        TextOptions.TextFormattingMode="Display" PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border x:Name="RootBorder" Margin="14" Background="#F21E1E2E" CornerRadius="12"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="18,14,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="DeskNest" Foreground="#B0FFFFFF" FontSize="13" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <ContentControl x:Name="ActionsHost" Grid.Row="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="← →   Enter   1–5   Esc" Foreground="#70FFFFFF" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </Grid>
    </Border>
</Window>
