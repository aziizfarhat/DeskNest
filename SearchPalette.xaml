<Window x:Class="DeskNest.SearchPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DeskNest"
        Title="DeskNest" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="True" ResizeMode="NoResize" Topmost="True"
        Width="680" Height="470" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="20" Background="#F21E1E2E" CornerRadius="12"
            BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.55" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="#18FFFFFF" CornerRadius="8" Padding="10,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#x2315;" FontSize="18" Foreground="#A0FFFFFF" Margin="0,0,9,0"
                               VerticalAlignment="Center"/>
                    <Grid Grid.Column="1">
                        <TextBox x:Name="QueryBox" Background="Transparent" BorderThickness="0"
                                 Foreground="White" CaretBrush="White" FontSize="18"
                                 VerticalContentAlignment="Center" />
                        <TextBlock x:Name="HintText" l:L.Key="search.everywhere"
                                   Foreground="#70FFFFFF" FontSize="18" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                         Foreground="White" SelectionMode="Single" IsTextSearchEnabled="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="6,5">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#3D2E7DD1"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="4,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="#8CFFFFFF"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Source}" FontSize="11"
                                           Foreground="#7AFFFFFF" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="EmptyText" l:L.Key="search.noResults" Visibility="Collapsed"
                           Foreground="#80FFFFFF" FontSize="13" HorizontalAlignment="Center"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <Grid Grid.Row="2" Margin="4,10,4,0">
                <TextBlock x:Name="CountText" Foreground="#70FFFFFF" FontSize="11"/>
                <TextBlock Text="↑ ↓   Enter   Esc" Foreground="#70FFFFFF" FontSize="11"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
