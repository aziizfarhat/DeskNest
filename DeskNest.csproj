<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DeskNest</AssemblyName>
    <RootNamespace>DeskNest</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.7.2.1</Version>
    <AssemblyVersion>0.7.2.1</AssemblyVersion>
    <FileVersion>0.7.2.1</FileVersion>
    <AssemblyTitle>DeskNest</AssemblyTitle>
    <Product>DeskNest</Product>
    <Description>Zones de rangement pour le bureau Windows</Description>
    <Company>DeskNest</Company>
    <Copyright>© 2026 DeskNest</Copyright>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <!-- WFAC010 : dpiAware/dpiAwareness du manifeste sont volontaires (voir app.manifest). -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
</Project>
