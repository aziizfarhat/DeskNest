<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DeskNest</AssemblyName>
    <RootNamespace>DeskNest</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.8.3.3</Version>
    <AssemblyVersion>0.8.3.3</AssemblyVersion>
    <FileVersion>0.8.3.3</FileVersion>
    <AssemblyTitle>DeskNest</AssemblyTitle>
    <Product>DeskNest</Product>
    <Description>Zones de rangement pour le bureau Windows</Description>
    <Company>DeskNest</Company>
    <Copyright>© 2026 aziizfarhat</Copyright>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <!-- WFAC010 : dpiAware/dpiAwareness du manifeste sont volontaires (voir app.manifest). -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Logo avec le nom, affiché dans Réglages › À propos. -->
    <Resource Include="logo\logo_name.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- Projet de tests : ses sources ne font pas partie de l'application. -->
    <Compile Remove="DeskNest.Tests\**\*.cs" />
    <Page Remove="DeskNest.Tests\**" />
    <None Remove="DeskNest.Tests\**" />
    <EmbeddedResource Remove="DeskNest.Tests\**" />
  </ItemGroup>
</Project>
