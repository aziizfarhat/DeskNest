<Window x:Class="DeskNest.NestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DeskNest"
        Title="DeskNest" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" AllowDrop="True"
        MinWidth="120" MinHeight="60" Width="320" Height="240">

    <Window.Resources>
        <!-- Poignées de redimensionnement (gérées à la main, sans comportement de fenêtre Windows) -->
        <Style x:Key="HandleStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="Transparent"/>
            <EventSetter Event="MouseLeftButtonDown" Handler="Handle_Down"/>
            <EventSetter Event="MouseMove" Handler="Handle_Move"/>
            <EventSetter Event="MouseLeftButtonUp" Handler="Handle_Up"/>
            <EventSetter Event="LostMouseCapture" Handler="Handle_LostCapture"/>
        </Style>

        <!-- Bouton plat (menu de la zone) -->
        <Style x:Key="FlatIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barre de défilement fine et discrète -->
        <Style x:Key="FlatRepeat" TargetType="RepeatButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SlimThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Background="#55FFFFFF" CornerRadius="2" Margin="3,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#A0FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#E0FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FlatRepeat}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FlatRepeat}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Disposition des éléments : grille (icônes) ou liste (une ligne par élément). -->
        <ItemsPanelTemplate x:Key="GridItemsPanel">
            <WrapPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListItemsPanel">
            <StackPanel/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="GridItemTemplate">
            <Border x:Name="Cell" Width="{Binding CellWidth}" Margin="2,2,2,4" Padding="2,4,2,3"
                    CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    AllowDrop="True" ToolTip="{Binding FullPath}"
                    MouseLeftButtonDown="Item_MouseLeftButtonDown" MouseLeftButtonUp="Item_MouseLeftButtonUp"
                    MouseMove="Item_MouseMove" PreviewMouseRightButtonDown="Item_RightDown">
                <StackPanel>
                    <Image x:Name="Icon" Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}"
                           HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Image.RenderTransform>
                    </Image>
                    <Grid Margin="0,3,0,0">
                        <TextBlock x:Name="NameText" Tag="name" Text="{Binding Name}" Foreground="White"
                                   TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                        <TextBox x:Name="NameEdit" Visibility="Collapsed" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Center" TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="46"
                                 Padding="1" Foreground="White" CaretBrush="White" Background="#99000000" BorderBrush="#AAFFFFFF"
                                 KeyDown="NameEdit_KeyDown" LostKeyboardFocus="NameEdit_LostKeyboardFocus"/>
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <!-- Effet de survol -->
                <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Cell" Property="Background" Value="#33FFFFFF"/>
                    <Setter TargetName="Cell" Property="BorderBrush" Value="#50FFFFFF"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Icon"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.12" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetName="Icon"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.12" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Icon"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetName="Icon"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <!-- Élément sélectionné -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Cell" Property="Background" Value="#55337ECC"/>
                    <Setter TargetName="Cell" Property="BorderBrush" Value="#CC5AA9FF"/>
                </DataTrigger>
                <!-- Renommage sur place -->
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="NameText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="NameEdit" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ListItemTemplate">
            <Border x:Name="Cell" Margin="2,1" Padding="6,3" CornerRadius="6"
                    Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                    AllowDrop="True" ToolTip="{Binding FullPath}"
                    MouseLeftButtonDown="Item_MouseLeftButtonDown" MouseLeftButtonUp="Item_MouseLeftButtonUp"
                    MouseMove="Item_MouseMove" PreviewMouseRightButtonDown="Item_RightDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="Icon" Source="{Binding Icon}" Width="{Binding IconSize}" Height="{Binding IconSize}"
                           VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Image.RenderTransform>
                    </Image>
                    <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" Tag="name" Text="{Binding Name}" Foreground="White"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBox x:Name="NameEdit" Visibility="Collapsed" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                 TextAlignment="Left" AcceptsReturn="False" Padding="1"
                                 Foreground="White" CaretBrush="White" Background="#99000000" BorderBrush="#AAFFFFFF"
                                 KeyDown="NameEdit_KeyDown" LostKeyboardFocus="NameEdit_LostKeyboardFocus"/>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- Effet de survol -->
                <Trigger SourceName="Cell" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Cell" Property="Background" Value="#33FFFFFF"/>
                    <Setter TargetName="Cell" Property="BorderBrush" Value="#50FFFFFF"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Icon"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1.12" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetName="Icon"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1.12" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Icon"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.12"/>
                                <DoubleAnimation Storyboard.TargetName="Icon"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.12"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <!-- Élément sélectionné -->
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Cell" Property="Background" Value="#55337ECC"/>
                    <Setter TargetName="Cell" Property="BorderBrush" Value="#CC5AA9FF"/>
                </DataTrigger>
                <!-- Renommage sur place -->
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="NameText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="NameEdit" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root" CornerRadius="10" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#BF1E1E2E"
            AllowDrop="True" MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseMove="Root_MouseMove"
            MouseLeftButtonUp="Root_MouseLeftButtonUp" LostMouseCapture="Root_LostMouseCapture"
            DragEnter="Root_DragEnter" DragOver="Root_DragOver" DragLeave="Root_DragLeave" Drop="Root_Drop">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0" Height="28" Background="#33FFFFFF" CornerRadius="9,9,0,0" AllowDrop="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Bouton menu : ouvre le même menu que le clic droit -->
                    <Button x:Name="MenuButton" Grid.Column="0" Width="24" Height="22" Margin="12,0,0,0"
                            Style="{StaticResource FlatIconButton}" Click="MenuButton_Click" l:L.TipKey="m.tooltip">
                        <Path Data="M2,4 H12 M2,7 H12 M2,10 H12" Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
                    </Button>

                    <!-- Folder Portal : retour au dossier précédent -->
                    <Button x:Name="BackButton" Grid.Column="1" Width="24" Height="22" Margin="0,0,0,0"
                            Style="{StaticResource FlatIconButton}" Click="BackButton_Click"
                            Visibility="Collapsed" l:L.TipKey="m.back">
                        <Path Data="M9,3 L4,8 L9,13" Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
                    </Button>

                    <!-- Icône : grille = zone normale, dossier = Folder Portal -->
                    <Path x:Name="TitleIcon" Grid.Column="2" Fill="#E6FFFFFF" Stretch="Uniform"
                          Width="14" Height="14" Margin="6,0,6,0" VerticalAlignment="Center"/>

                    <!-- Double-clic sur le titre : modification -->
                    <TextBlock x:Name="TitleText" Grid.Column="3" Foreground="White" FontSize="{Binding Data.TitleFontSize, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold"
                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,8,0"
                               Background="Transparent" TextTrimming="CharacterEllipsis"
                               MouseLeftButtonDown="TitleText_MouseLeftButtonDown"/>
                    <TextBox x:Name="TitleEdit" Grid.Column="3" Visibility="Collapsed" Height="22" Margin="0,0,8,0"
                             VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="2,0"
                             FontSize="{Binding Data.TitleFontSize, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" CaretBrush="White" Background="#66000000" BorderBrush="#88FFFFFF"
                             KeyDown="TitleEdit_KeyDown" LostKeyboardFocus="TitleEdit_LostKeyboardFocus"/>
                </Grid>
            </Border>

            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Margin="0,0,6,0" Padding="8,6,4,8" AllowDrop="True">
                <ItemsControl x:Name="ItemsHost" AllowDrop="True"
                              ItemsPanel="{StaticResource GridItemsPanel}"
                              ItemTemplate="{StaticResource GridItemTemplate}"/>
            </ScrollViewer>

            <!-- Pagination des Folder Portals : seuls les éléments de la page courante sont instanciés. -->
            <Border x:Name="PagerBar" Grid.Row="2" Height="24" Visibility="Collapsed" Background="#22000000"
                    CornerRadius="0,0,9,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PagerPrev" Grid.Column="0" Width="24" Height="20" Margin="6,0,0,0"
                            Style="{StaticResource FlatIconButton}" Click="PagerPrev_Click">
                        <Path Data="M9,3 L4,8 L9,13" Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
                    </Button>
                    <TextBlock x:Name="PagerText" Grid.Column="1" Foreground="#CCFFFFFF" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Button x:Name="PagerNext" Grid.Column="2" Width="24" Height="20" Margin="0,0,6,0"
                            Style="{StaticResource FlatIconButton}" Click="PagerNext_Click">
                        <Path Data="M4,3 L9,8 L4,13" Stroke="White" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Indication de dépôt (Folder Portal : déplacer / copier dans le dossier) -->
            <Border x:Name="DropHint" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10"
                    Padding="10,4" CornerRadius="6" Background="#D9000000" IsHitTestVisible="False" Visibility="Collapsed">
                <TextBlock x:Name="DropHintText" Foreground="White" FontSize="11"/>
            </Border>

            <!-- Repère d'insertion (tri personnalisé) et rectangle de sélection -->
            <Canvas x:Name="Overlay" Grid.Row="1" IsHitTestVisible="False" FlowDirection="LeftToRight">
                <Rectangle x:Name="Marker" Width="2" Height="40" RadiusX="1" RadiusY="1"
                           Fill="#F2FFFFFF" Visibility="Collapsed"/>
                <Rectangle x:Name="SelBox" Visibility="Collapsed" Fill="#332E7DD1" Stroke="#AA5AA9FF" StrokeThickness="1"/>
            </Canvas>

            <Grid x:Name="Handles" Grid.RowSpan="3">
                <Rectangle Style="{StaticResource HandleStyle}" Tag="1"  Width="6" HorizontalAlignment="Left"  Margin="0,12" Cursor="SizeWE"/>
                <Rectangle Style="{StaticResource HandleStyle}" Tag="4"  Width="6" HorizontalAlignment="Right" Margin="0,12" Cursor="SizeWE"/>
                <Rectangle Style="{StaticResource HandleStyle}" Tag="2"  Height="6" VerticalAlignment="Top"    Margin="12,0" Cursor="SizeNS"/>
                <Rectangle Style="{StaticResource HandleStyle}" Tag="8"  Height="6" VerticalAlignment="Bottom" Margin="12,0" Cursor="SizeNS"/>
                <Rectangle Style="{StaticResource HandleStyle}" Tag="3"  Width="12" Height="12" HorizontalAlignment="Left"  VerticalAlignment="Top"    Cursor="SizeNWSE"/>
                <Rectangle Style="{StaticResource HandleStyle}" Tag="6"  Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"    Cursor="SizeNESW"/>
                <Rectangle Style="{StaticResource HandleStyle}" Tag="9"  Width="12" Height="12" HorizontalAlignment="Left"  VerticalAlignment="Bottom" Cursor="SizeNESW"/>
                <Rectangle Style="{StaticResource HandleStyle}" Tag="12" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
            </Grid>
        </Grid>
    </Border>
</Window>