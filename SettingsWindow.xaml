<Window x:Class="DeskNest.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DeskNest"
        l:L.Key="s.title" Width="700" Height="640" MinWidth="620" MinHeight="540"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,0,0,10"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="MainTabs" Grid.Row="0">

            <!-- ===== Général ===== -->
            <TabItem l:L.Key="tab.general">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock l:L.Key="g.language" Style="{StaticResource Label}" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbLanguage" Width="240" HorizontalAlignment="Left" Margin="0,0,0,16"
                                  SelectionChanged="CmbLanguage_Changed"/>

                        <CheckBox x:Name="ChkEnabled" l:L.Key="g.enabled" Click="ChkEnabled_Click"/>
                        <CheckBox x:Name="ChkAutostart" l:L.Key="g.autostart" Click="ChkAutostart_Click"/>
                        <CheckBox x:Name="ChkHotkey" l:L.Key="g.hotkey" Click="ChkHotkey_Click"/>
                        <CheckBox x:Name="ChkDesktopDbl" l:L.Key="g.dblclick" Click="ChkDesktopDbl_Click"/>
                        <CheckBox x:Name="ChkHideIcons" l:L.Key="g.hideIcons" Click="ChkHideIcons_Click"/>
                        <TextBlock l:L.Key="g.method" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="CmbDesktopMode" Margin="0,0,0,10" SelectionChanged="CmbDesktopMode_Changed"/>
                        <TextBlock l:L.Key="g.hint" Style="{StaticResource Hint}"/>
                        <Button l:L.Key="tray.restoreIcons" Click="RestoreIcons_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Zones ===== -->
            <TabItem x:Name="ZonesTab" l:L.Key="tab.zones">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <Button l:L.Key="tray.newZone" Click="NewZone_Click"/>
                            <Button l:L.Key="tray.newPortal" Click="NewPortal_Click"/>
                            <Button l:L.Key="m.deleteZone" Click="DeleteZone_Click"/>
                        </StackPanel>
                        <ListBox x:Name="ZoneList" DisplayMemberPath="Label" SelectionChanged="ZoneList_SelectionChanged"/>
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ZonePanel" IsEnabled="False" Margin="0,0,8,0">
                            <CheckBox x:Name="ZVisible" l:L.Key="z.visible" Click="Zone_Changed"/>

                            <TextBlock l:L.Key="z.name" Style="{StaticResource Label}"/>
                            <TextBox x:Name="ZName" Padding="3" TextChanged="ZName_TextChanged"/>

                            <TextBlock l:L.Key="m.color" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="ZColor" SelectionChanged="ZColor_Changed"/>
                            <TextBlock l:L.Key="z.hex" Style="{StaticResource Hint}" Margin="0,4,0,2"/>
                            <TextBox x:Name="ZHex" Padding="3" MaxLength="7" Width="110" HorizontalAlignment="Left" TextChanged="ZHex_TextChanged"/>

                            <TextBlock x:Name="ZOpacityLabel" Style="{StaticResource Label}"/>
                            <Slider x:Name="ZOpacity" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="ZOpacity_Changed"/>

                            <TextBlock l:L.Key="m.iconSize" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="ZIcon" SelectionChanged="ZIcon_Changed" Margin="0,0,0,10"/>

                            <TextBlock l:L.Key="z.titleFont" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="ZTitleFont" SelectionChanged="ZTitleFont_Changed" Margin="0,0,0,4"/>

                            <TextBlock l:L.Key="z.titleFontSize" Style="{StaticResource Label}"/>
                            <Slider x:Name="ZTitleFontSize" Minimum="8" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ZTitleFontSize_Changed"/>
                            <TextBlock x:Name="ZTitleFontSizeValue" Style="{StaticResource Hint}"/>

                            <TextBlock l:L.Key="z.itemFont" Style="{StaticResource Label}"/>
                            <ComboBox x:Name="ZItemFont" SelectionChanged="ZItemFont_Changed" Margin="0,0,0,4"/>

                            <TextBlock l:L.Key="z.itemFontSize" Style="{StaticResource Label}"/>
                            <Slider x:Name="ZItemFontSize" Minimum="8" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ZItemFontSize_Changed"/>
                            <TextBlock x:Name="ZItemFontSizeValue" Style="{StaticResource Hint}"/>

                            <CheckBox x:Name="ZTitle" l:L.Key="m.showTitle" Click="Zone_Changed"/>
                            <CheckBox x:Name="ZLocked" l:L.Key="z.locked" Click="Zone_Changed"/>
                            <CheckBox x:Name="ZRolled" l:L.Key="z.rolled" Click="Zone_Changed"/>
                            <CheckBox x:Name="ZHover" l:L.Key="z.hover" Click="Zone_Changed"/>

                            <TextBlock x:Name="ZInfo" Style="{StaticResource Hint}"/>
                            <Button l:L.Key="z.applyAll" Click="ApplyAll_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===== Comportement ===== -->
            <TabItem l:L.Key="tab.behavior">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <CheckBox x:Name="ChkHover" l:L.Key="b.hover" Click="ChkHover_Click"/>

                        <TextBlock x:Name="HoverDelayLabel" Style="{StaticResource Label}"/>
                        <Slider x:Name="HoverDelay" Minimum="0" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="HoverDelay_Changed"/>

                        <TextBlock x:Name="CollapseDelayLabel" Style="{StaticResource Label}"/>
                        <Slider x:Name="CollapseDelay" Minimum="100" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True" ValueChanged="CollapseDelay_Changed"/>

                        <CheckBox x:Name="ChkAnimate" l:L.Key="b.animate" Margin="0,18,0,10" Click="ChkAnimate_Click"/>
                        <TextBlock x:Name="AnimMsLabel" Style="{StaticResource Label}"/>
                        <Slider x:Name="AnimMs" Minimum="80" Maximum="600" TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="AnimMs_Changed"/>

                        <TextBlock l:L.Key="b.hint" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Apparence ===== -->
            <TabItem l:L.Key="tab.appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock l:L.Key="a.defaults" FontWeight="Bold" FontSize="14"/>

                        <TextBlock l:L.Key="m.color" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="DColor" SelectionChanged="DColor_Changed"/>

                        <TextBlock x:Name="DOpacityLabel" Style="{StaticResource Label}"/>
                        <Slider x:Name="DOpacity" Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="DOpacity_Changed"/>

                        <TextBlock l:L.Key="m.iconSize" Style="{StaticResource Label}"/>
                        <ComboBox x:Name="DIcon" SelectionChanged="DIcon_Changed" Margin="0,0,0,10"/>

                        <Button l:L.Key="a.apply" Click="ApplyDefaults_Click"/>

                        <TextBlock l:L.Key="a.common" FontWeight="Bold" FontSize="14" Margin="0,18,0,0"/>
                        <TextBlock x:Name="RadiusLabel" Style="{StaticResource Label}"/>
                        <Slider x:Name="Radius" Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Radius_Changed"/>
                        <CheckBox x:Name="ChkBorder" l:L.Key="a.border" Margin="0,8,0,0" Click="ChkBorder_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Sauvegardes ===== -->
            <TabItem l:L.Key="tab.backups">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock l:L.Key="k.hint" Style="{StaticResource Hint}"/>
                        <Button l:L.Key="k.snapshot" Click="Snapshot_Click"/>
                        <Button l:L.Key="k.restore" Click="Restore_Click"/>
                        <Button l:L.Key="tray.openConfig" Click="OpenFolder_Click"/>
                        <TextBlock x:Name="DataPath" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== À propos ===== -->
            <TabItem l:L.Key="tab.about">
                <StackPanel Margin="16">
                    <TextBlock Text="DeskNest" FontSize="20" FontWeight="Bold"/>
                    <TextBlock x:Name="AboutVersion" Margin="0,4,0,10"/>
                    <TextBlock l:L.Key="ab.text" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Button Grid.Row="1" l:L.Key="s.close" Width="90" HorizontalAlignment="Right" Margin="0,10,0,0" IsDefault="True" Click="Close_Click"/>
    </Grid>
</Window>
