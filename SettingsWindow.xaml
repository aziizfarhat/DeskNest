<Window x:Class="DeskNest.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DeskNest"
        l:L.Key="s.title" Width="780" Height="700" MinWidth="680" MinHeight="580"
        WindowStartupLocation="CenterScreen" FontSize="13" Background="#FFF6F6F8">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1A000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="BorderBrush" Value="#33000000"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="HexBox" TargetType="TextBox">
            <Setter Property="Width" Value="96"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="MaxLength" Value="7"/>
        </Style>
        <Style x:Key="PickButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <!-- Tableau des raccourcis clavier -->
        <Style x:Key="ShortcutKey" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,14,7"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="ShortcutDesc" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#FFFFFFFF" BorderBrush="#1A000000" BorderThickness="0,0,0,1"
                Padding="20,14">
            <StackPanel>
                <TextBlock Text="DeskNest" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="HeaderVersion" Foreground="#777777" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="12,12,12,0"
                    Background="Transparent" BorderThickness="0" Padding="0">

            <!-- ===== Général ===== -->
            <TabItem l:L.Key="tab.general">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,12">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock l:L.Key="tab.general" Style="{StaticResource SectionTitle}"/>

                                <TextBlock l:L.Key="g.language" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbLanguage" Width="260" HorizontalAlignment="Left"
                                          Margin="0,0,0,14" SelectionChanged="CmbLanguage_Changed"/>

                                <CheckBox x:Name="ChkEnabled" l:L.Key="g.enabled" Click="ChkEnabled_Click"/>
                                <CheckBox x:Name="ChkAutostart" l:L.Key="g.autostart" Click="ChkAutostart_Click"/>
                                <CheckBox x:Name="ChkHotkey" l:L.Key="g.hotkey" Click="ChkHotkey_Click"/>
                                <CheckBox x:Name="ChkDesktopDbl" l:L.Key="g.dblclick" Click="ChkDesktopDbl_Click"/>
                                <CheckBox x:Name="ChkHideIcons" l:L.Key="g.hideIcons" Click="ChkHideIcons_Click"/>
                                <CheckBox x:Name="ChkSearchBar" l:L.Key="g.searchBar" Click="ChkSearchBar_Click"/>
                                <CheckBox x:Name="ChkSnap" l:L.Key="g.snap" Click="ChkSnap_Click"/>
                                <CheckBox x:Name="ChkUpdates" l:L.Key="g.updates" Click="ChkUpdates_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock l:L.Key="g.method" Style="{StaticResource SectionTitle}"/>
                                <ComboBox x:Name="CmbDesktopMode" Margin="0,0,0,8"
                                          SelectionChanged="CmbDesktopMode_Changed"/>
                                <TextBlock l:L.Key="g.hint" Style="{StaticResource Hint}"/>
                                <Button l:L.Key="tray.restoreIcons" Click="RestoreIcons_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Zones ===== -->
            <TabItem x:Name="ZonesTab" l:L.Key="tab.zones">
                <Grid Margin="4,12,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Section}" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" l:L.Key="tab.zones"
                                       Style="{StaticResource SectionTitle}"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button l:L.Key="tray.newZone" Click="NewZone_Click"/>
                                <Button l:L.Key="tray.newPortal" Click="NewPortal_Click"/>
                                <Button l:L.Key="m.deleteZone" Click="DeleteZone_Click"/>
                            </StackPanel>
                            <ListBox x:Name="ZoneList" DisplayMemberPath="Label"
                                     BorderThickness="0" Background="Transparent"
                                     SelectionChanged="ZoneList_SelectionChanged"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ZonePanel" IsEnabled="False" Margin="0,0,8,0">

                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock l:L.Key="s.zone" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox x:Name="ZVisible" l:L.Key="z.visible" Click="Zone_Changed"/>

                                    <TextBlock l:L.Key="z.name" Style="{StaticResource Label}" Margin="0,6,0,4"/>
                                    <TextBox x:Name="ZName" Padding="4,3" TextChanged="ZName_TextChanged"/>

                                    <TextBlock l:L.Key="m.color" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="ZColor" SelectionChanged="ZColor_Changed" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="ZColorSwatch" Style="{StaticResource Swatch}"/>
                                        <TextBox x:Name="ZHex" Style="{StaticResource HexBox}"
                                                 l:L.TipKey="z.hex" TextChanged="ZHex_TextChanged"/>
                                        <Button Style="{StaticResource PickButton}"
                                                l:L.TipKey="s.colorPick" Click="PickZoneColor_Click">
                                            <Grid Width="14" Height="14">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/><RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/><ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle Grid.Row="0" Grid.Column="0" Fill="#E74C3C"/>
                                                <Rectangle Grid.Row="0" Grid.Column="1" Fill="#F1C40F"/>
                                                <Rectangle Grid.Row="1" Grid.Column="0" Fill="#2ECC71"/>
                                                <Rectangle Grid.Row="1" Grid.Column="1" Fill="#3498DB"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock l:L.Key="bg.title" Style="{StaticResource SectionTitle}"/>

                                    <TextBlock l:L.Key="bg.mode" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="ZBgMode" SelectionChanged="ZBgMode_Changed" Margin="0,0,0,6"/>

                                    <!-- Dégradé : deux couleurs et un angle. -->
                                    <StackPanel x:Name="ZGradPanel">
                                        <TextBlock l:L.Key="bg.start" Style="{StaticResource Label}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border x:Name="ZGradStartSwatch" Style="{StaticResource Swatch}"/>
                                            <TextBox x:Name="ZGradStartHex" Style="{StaticResource HexBox}"
                                                     l:L.TipKey="z.hex" TextChanged="ZGradStartHex_TextChanged"/>
                                            <Button Style="{StaticResource PickButton}"
                                                    l:L.TipKey="s.colorPick" Click="PickGradientStart_Click">
                                                <Grid Width="14" Height="14">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/><RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/><ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="#E74C3C"/>
                                                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="#F1C40F"/>
                                                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="#2ECC71"/>
                                                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="#3498DB"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>

                                        <TextBlock l:L.Key="bg.end" Style="{StaticResource Label}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Border x:Name="ZGradEndSwatch" Style="{StaticResource Swatch}"/>
                                            <TextBox x:Name="ZGradEndHex" Style="{StaticResource HexBox}"
                                                     l:L.TipKey="z.hex" TextChanged="ZGradEndHex_TextChanged"/>
                                            <Button Style="{StaticResource PickButton}"
                                                    l:L.TipKey="s.colorPick" Click="PickGradientEnd_Click">
                                                <Grid Width="14" Height="14">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition/><RowDefinition/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/><ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Grid.Row="0" Grid.Column="0" Fill="#E74C3C"/>
                                                    <Rectangle Grid.Row="0" Grid.Column="1" Fill="#F1C40F"/>
                                                    <Rectangle Grid.Row="1" Grid.Column="0" Fill="#2ECC71"/>
                                                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="#3498DB"/>
                                                </Grid>
                                            </Button>
                                        </StackPanel>

                                        <TextBlock x:Name="ZGradAngleLabel" Style="{StaticResource Label}"/>
                                        <Slider x:Name="ZGradAngle" Minimum="0" Maximum="359" TickFrequency="15"
                                                IsSnapToTickEnabled="True" ValueChanged="ZGradAngle_Changed"/>
                                    </StackPanel>

                                    <!-- Image choisie par l'utilisateur. -->
                                    <StackPanel x:Name="ZImagePanel">
                                        <TextBlock x:Name="ZImagePath" Style="{StaticResource Hint}" Margin="0,8,0,6"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button l:L.Key="bg.choose" Click="ChooseZoneImage_Click" Margin="0,0,8,0"/>
                                            <Button l:L.Key="bg.clear" Click="ClearZoneImage_Click"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock l:L.Key="bg.hint" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock l:L.Key="tab.appearance" Style="{StaticResource SectionTitle}"/>

                                    <TextBlock x:Name="ZOpacityLabel" Style="{StaticResource Label}"/>
                                    <Slider x:Name="ZOpacity" Minimum="10" Maximum="100" TickFrequency="5"
                                            IsSnapToTickEnabled="True" ValueChanged="ZOpacity_Changed"/>

                                    <TextBlock l:L.Key="m.iconSize" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="ZIcon" SelectionChanged="ZIcon_Changed" Margin="0,0,0,10"/>

                                    <TextBlock l:L.Key="z.view" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="ZView" SelectionChanged="ZView_Changed"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock l:L.Key="s.typography" Style="{StaticResource SectionTitle}"/>

                                    <TextBlock l:L.Key="z.titleFont" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="ZTitleFont" SelectionChanged="ZTitleFont_Changed"
                                              Margin="0,0,0,4"/>

                                    <TextBlock l:L.Key="z.titleFontSize" Style="{StaticResource Label}"/>
                                    <Slider x:Name="ZTitleFontSize" Minimum="8" Maximum="24" TickFrequency="1"
                                            IsSnapToTickEnabled="True" ValueChanged="ZTitleFontSize_Changed"/>
                                    <TextBlock x:Name="ZTitleFontSizeValue" Style="{StaticResource Hint}"/>

                                    <TextBlock l:L.Key="z.itemFont" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="ZItemFont" SelectionChanged="ZItemFont_Changed"
                                              Margin="0,0,0,4"/>

                                    <TextBlock l:L.Key="z.itemFontSize" Style="{StaticResource Label}"/>
                                    <Slider x:Name="ZItemFontSize" Minimum="8" Maximum="20" TickFrequency="1"
                                            IsSnapToTickEnabled="True" ValueChanged="ZItemFontSize_Changed"/>
                                    <TextBlock x:Name="ZItemFontSizeValue" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock l:L.Key="tab.behavior" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox x:Name="ZTitle" l:L.Key="m.showTitle" Click="Zone_Changed"/>
                                    <CheckBox x:Name="ZLocked" l:L.Key="z.locked" Click="Zone_Changed"/>
                                    <CheckBox x:Name="ZRolled" l:L.Key="z.rolled" Click="Zone_Changed"/>
                                    <CheckBox x:Name="ZHover" l:L.Key="z.hover" Click="Zone_Changed"/>

                                    <TextBlock x:Name="ZInfo" Style="{StaticResource Hint}" Margin="0,6,0,10"/>
                                    <Button l:L.Key="z.applyAll" Click="ApplyAll_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===== Comportement ===== -->
            <TabItem l:L.Key="tab.behavior">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,12">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock l:L.Key="tab.behavior" Style="{StaticResource SectionTitle}"/>

                                <CheckBox x:Name="ChkHover" l:L.Key="b.hover" Click="ChkHover_Click"/>

                                <TextBlock x:Name="HoverDelayLabel" Style="{StaticResource Label}"/>
                                <Slider x:Name="HoverDelay" Minimum="0" Maximum="1500" TickFrequency="50"
                                        IsSnapToTickEnabled="True" ValueChanged="HoverDelay_Changed"/>

                                <TextBlock x:Name="CollapseDelayLabel" Style="{StaticResource Label}"/>
                                <Slider x:Name="CollapseDelay" Minimum="100" Maximum="3000" TickFrequency="100"
                                        IsSnapToTickEnabled="True" ValueChanged="CollapseDelay_Changed"/>

                                <CheckBox x:Name="ChkAnimate" l:L.Key="b.animate" Margin="0,18,0,8"
                                          Click="ChkAnimate_Click"/>

                                <TextBlock x:Name="AnimMsLabel" Style="{StaticResource Label}"/>
                                <Slider x:Name="AnimMs" Minimum="80" Maximum="600" TickFrequency="20"
                                        IsSnapToTickEnabled="True" ValueChanged="AnimMs_Changed"/>

                                <CheckBox x:Name="ChkThumbnails" l:L.Key="b.showThumbnails" Margin="0,18,0,8"
                                          Click="ChkThumbnails_Click"/>

                                <CheckBox x:Name="ChkSingleClick" l:L.Key="b.singleClick" Margin="0,0,0,8"
                                          Click="ChkSingleClick_Click"/>

                                <TextBlock l:L.Key="b.hint" Style="{StaticResource Hint}" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Apparence ===== -->
            <TabItem l:L.Key="tab.appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,12">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock l:L.Key="a.defaults" Style="{StaticResource SectionTitle}"/>

                                <TextBlock l:L.Key="m.color" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="DColor" SelectionChanged="DColor_Changed" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border x:Name="DColorSwatch" Style="{StaticResource Swatch}"/>
                                    <TextBox x:Name="DHex" Style="{StaticResource HexBox}"
                                             l:L.TipKey="z.hex" TextChanged="DHex_TextChanged"/>
                                    <Button Style="{StaticResource PickButton}"
                                            l:L.TipKey="s.colorPick" Click="PickDefaultColor_Click">
                                        <Grid Width="14" Height="14">
                                            <Grid.RowDefinitions>
                                                <RowDefinition/><RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/><ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#E74C3C"/>
                                            <Rectangle Grid.Row="0" Grid.Column="1" Fill="#F1C40F"/>
                                            <Rectangle Grid.Row="1" Grid.Column="0" Fill="#2ECC71"/>
                                            <Rectangle Grid.Row="1" Grid.Column="1" Fill="#3498DB"/>
                                        </Grid>
                                    </Button>
                                </StackPanel>

                                <TextBlock x:Name="DOpacityLabel" Style="{StaticResource Label}"/>
                                <Slider x:Name="DOpacity" Minimum="10" Maximum="100" TickFrequency="5"
                                        IsSnapToTickEnabled="True" ValueChanged="DOpacity_Changed"/>

                                <TextBlock l:L.Key="m.iconSize" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="DIcon" SelectionChanged="DIcon_Changed" Margin="0,0,0,10"/>

                                <Button l:L.Key="a.apply" Click="ApplyDefaults_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock l:L.Key="a.common" Style="{StaticResource SectionTitle}"/>
                                <TextBlock x:Name="RadiusLabel" Style="{StaticResource Label}"/>
                                <Slider x:Name="Radius" Minimum="0" Maximum="24" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="Radius_Changed"/>
                                <CheckBox x:Name="ChkBorder" l:L.Key="a.border" Margin="0,8,0,0"
                                          Click="ChkBorder_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Modèles ===== -->
            <TabItem x:Name="TemplatesTab" l:L.Key="tab.templates">
                <Grid Margin="4,12,4,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Section}" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" l:L.Key="tab.templates"
                                       Style="{StaticResource SectionTitle}"/>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <Button l:L.Key="tpl.newZone" Click="TemplateNewZone_Click"/>
                                <Button l:L.Key="tpl.delete" Click="TemplateDelete_Click"/>
                            </StackPanel>
                            <ListBox x:Name="TemplateList" DisplayMemberPath="Name"
                                     BorderThickness="0" Background="Transparent"
                                     SelectionChanged="TemplateList_SelectionChanged"/>
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TemplatePanel" IsEnabled="False" Margin="0,0,8,0">
                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock l:L.Key="tpl.applyTitle" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock l:L.Key="tpl.applyHint" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                    <TextBlock l:L.Key="tpl.targetZone" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="TplTargetZone" DisplayMemberPath="Title" Margin="0,0,0,8"/>
                                    <Button l:L.Key="tpl.apply" Click="TemplateApply_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock l:L.Key="tpl.saveTitle" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock l:L.Key="tpl.saveHint" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                    <TextBlock l:L.Key="tpl.sourceZone" Style="{StaticResource Label}"/>
                                    <ComboBox x:Name="TplSourceZone" DisplayMemberPath="Title" Margin="0,0,0,8"/>
                                    <Button l:L.Key="m.saveTemplate" Click="TemplateSave_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Section}">
                                <StackPanel>
                                    <TextBlock x:Name="TemplateInfo" Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ===== Sauvegardes ===== -->
            <TabItem l:L.Key="tab.backups">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,12">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock l:L.Key="tab.backups" Style="{StaticResource SectionTitle}"/>
                                <TextBlock l:L.Key="k.hint" Style="{StaticResource Hint}"/>
                                <Button l:L.Key="k.snapshot" Click="Snapshot_Click"/>
                                <Button l:L.Key="k.restore" Click="Restore_Click"/>
                                <Button l:L.Key="tray.openConfig" Click="OpenFolder_Click"/>
                                <TextBlock x:Name="DataPath" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== Raccourcis clavier ===== -->
            <TabItem l:L.Key="tab.shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,12">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock l:L.Key="sc.global" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + Alt + F" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" l:L.Key="sc.toggle" Style="{StaticResource ShortcutDesc}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + Shift + Space" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" l:L.Key="sc.search" Style="{StaticResource ShortcutDesc}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" l:L.Key="sc.kDouble" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" l:L.Key="sc.desktop" Style="{StaticResource ShortcutDesc}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock l:L.Key="sc.zone" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" l:L.Key="sc.kDouble" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" l:L.Key="sc.roll" Style="{StaticResource ShortcutDesc}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" l:L.Key="sc.kEsc" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" l:L.Key="sc.escape" Style="{StaticResource ShortcutDesc}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + Z" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" l:L.Key="sc.undo" Style="{StaticResource ShortcutDesc}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ctrl + Y&#10;Ctrl + Shift + Z" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" l:L.Key="sc.redo" Style="{StaticResource ShortcutDesc}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Ctrl + A / C / X / V" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" l:L.Key="sc.clipboard" Style="{StaticResource ShortcutDesc}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock l:L.Key="sc.items" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" l:L.Key="sc.kEnter" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" l:L.Key="sc.open" Style="{StaticResource ShortcutDesc}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="F2" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" l:L.Key="sc.rename" Style="{StaticResource ShortcutDesc}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" l:L.Key="sc.kDel" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" l:L.Key="sc.delete" Style="{StaticResource ShortcutDesc}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" l:L.Key="sc.kShiftDel" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" l:L.Key="sc.deletePermanent" Style="{StaticResource ShortcutDesc}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Alt + ←&#10;Backspace" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" l:L.Key="sc.back" Style="{StaticResource ShortcutDesc}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" l:L.Key="sc.kMouseBack" Style="{StaticResource ShortcutKey}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" l:L.Key="sc.mouseBack" Style="{StaticResource ShortcutDesc}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== À propos ===== -->
            <TabItem l:L.Key="tab.about">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,12,4,12">
                        <Border Style="{StaticResource Section}">
                            <StackPanel>
                                <TextBlock Text="DeskNest" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="AboutVersion" Margin="0,4,0,10"/>
                                <TextBlock l:L.Key="ab.text" TextWrapping="Wrap"/>
                                <Button l:L.Key="ab.checkUpdates" Margin="0,12,0,0"
                                        HorizontalAlignment="Left" Click="CheckUpdates_Click"/>
                                <TextBlock l:L.Key="ab.license" TextWrapping="Wrap" Margin="0,10,0,0"
                                           Foreground="#666666"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="#1A000000" BorderThickness="0,1,0,0"
                Padding="16,10">
            <Button l:L.Key="s.close" Width="100" HorizontalAlignment="Right" Margin="0"
                    IsDefault="True" Click="Close_Click"/>
        </Border>
    </Grid>
</Window>
